{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "client/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/client/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/client/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "30 17 * * *"
    }
  ]
}
